# Copy to .env and replace every secret before starting the stack.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

POSTGRES_DB=firmspace
POSTGRES_USER=firmspace
POSTGRES_PASSWORD=replace_with_a_long_random_password
REDIS_PASSWORD=replace_with_another_long_random_password

# Base64 encoding of exactly 32 random bytes. Keep this value backed up;
# changing it makes previously stored provider API credentials unreadable.
APP_ENCRYPTION_KEY=replace_with_base64_32_byte_key

# Local development defaults. For a hosted HTTPS domain, set the browser origins
# to https://your-domain and COOKIE_SECURE=true.
APP_ORIGINS=http://localhost:8080
COOKIE_SECURE=false
SESSION_TTL_HOURS=12
LOG_LEVEL=info
